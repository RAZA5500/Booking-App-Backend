# Copy to .env for local overrides. Every value below has a dev fallback, but
# NODE_ENV=production makes the two JWT secrets mandatory.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Where the JSON database file lives (defaults to api/db/data.json)
# DATA_FILE=./db/data.json
